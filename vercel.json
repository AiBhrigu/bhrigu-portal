{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bhrigu.io"
        }
      ],
      "destination": "https://www.bhrigu.io/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bhrigu.io"
        }
      ],
      "destination": "https://www.bhrigu.io/:path*",
      "permanent": true
    }
  ]
}
